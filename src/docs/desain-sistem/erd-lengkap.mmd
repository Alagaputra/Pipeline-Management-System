erDiagram
    %% FK dan tipe fisik berasal dari PostgreSQL. Garis putus-putus: relasi logis.
    divisions o|--o{ users : division_id
    divisions ||--o{ division_products : division_id
    products ||--o{ division_products : product_id
    users o|--o{ opportunities : created_by
    divisions ||--o{ opportunities : division_id
    users ||--o{ opportunities : pic_id
    products ||--o{ opportunities : product_id
    users o|--o{ opportunities : updated_by
    users o|--o{ opportunity_assignments : changed_by
    opportunities ||--o{ opportunity_assignments : opportunity_id
    users ||--o{ opportunity_assignments : pic_id
    divisions o|--o{ target_scopes : division_id
    products ||--o{ annual_targets : product_id
    target_scopes ||--o{ annual_targets : scope_code
    users o|--o{ annual_targets : updated_by
    annual_targets ||--o{ monthly_targets : annual_target_id
    annual_targets ||--o{ unit_realizations : annual_target_id
    users o|--o{ unit_realizations : updated_by
    divisions ||--o{ branch_targets : division_id
    users o|--o{ branch_targets : updated_by
    users o|--o{ audit_events : actor_id
    users ||--o{ request_receipts : user_id
    users ||..o{ personal_access_tokens : "tokenable (logis)"
    users o|..o{ sessions : "user_id (logis)"
    divisions {
        bigint id PK "required"
        varchar code UK "required"
        varchar name "required"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    users {
        bigint id PK "required"
        bigint division_id FK "nullable"
        varchar username UK "required"
        varchar name "required"
        varchar email UK "nullable"
        timestamp email_verified_at "nullable"
        varchar password "required"
        varchar role "required"
        bool is_active "required"
        varchar remember_token "nullable"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    products {
        bigint id PK "required"
        varchar code UK "required"
        varchar name "required"
        varchar measure "required"
        bool is_active "required"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    division_products {
        bigint division_id FK, PK "required"
        bigint product_id FK, PK "required"
    }
    opportunities {
        bigint id PK "required"
        varchar legacy_id UK "nullable"
        bigint division_id FK "required"
        bigint pic_id FK "required"
        bigint product_id FK "required"
        varchar customer_name "required"
        varchar segment "required"
        bigint nominal "required"
        varchar interest_status "required"
        varchar outcome "required"
        date recorded_date "required"
        date follow_up_date "nullable"
        bool follow_up_completed "required"
        date closed_date "nullable"
        bigint realization "required"
        text notes "nullable"
        text lost_reason "nullable"
        bigint created_by FK "nullable"
        bigint updated_by FK "nullable"
        bigint version "required"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    opportunity_assignments {
        bigint id PK "required"
        bigint opportunity_id FK "required"
        bigint pic_id FK "required"
        timestamp assigned_at "nullable"
        timestamp unassigned_at "nullable"
        bigint changed_by FK "nullable"
        varchar source "required"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    target_scopes {
        varchar code PK "required"
        bigint division_id FK "nullable"
        varchar label "required"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    annual_targets {
        bigint id PK "required"
        varchar scope_code FK "required"
        bigint product_id FK "required"
        smallint year "required"
        bigint target_value "required"
        bigint updated_by FK "nullable"
        bigint version "required"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    monthly_targets {
        bigint id PK "required"
        bigint annual_target_id FK "required"
        smallint month "required"
        bigint target_value "required"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    unit_realizations {
        bigint id PK "required"
        bigint annual_target_id FK "required"
        smallint month "required"
        bigint units "required"
        bigint updated_by FK "nullable"
        bigint version "required"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    branch_targets {
        bigint id PK "required"
        bigint division_id FK "required"
        varchar branch_code "required"
        smallint year "required"
        bigint target_value "required"
        bigint updated_by FK "nullable"
        bigint version "required"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    audit_events {
        bigint id PK "required"
        bigint actor_id FK "nullable"
        varchar resource_type "required"
        varchar resource_id "required"
        varchar action "required"
        json before_data "nullable"
        json after_data "nullable"
        timestamp occurred_at "required"
        varchar source "required"
    }
    request_receipts {
        bigint id PK "required"
        bigint user_id FK "required"
        uuid request_key "required"
        varchar request_hash "required"
        smallint status_code "required"
        text response_body "required"
        timestamp created_at "required"
    }
    personal_access_tokens {
        bigint id PK "required"
        varchar tokenable_type "required"
        bigint tokenable_id "required"
        text name "required"
        varchar token UK "required"
        text abilities "nullable"
        timestamp last_used_at "nullable"
        timestamp expires_at "nullable"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }
    password_reset_tokens {
        varchar email PK "required"
        varchar token "required"
        timestamp created_at "nullable"
    }
    sessions {
        varchar id PK "required"
        bigint user_id "nullable"
        varchar ip_address "nullable"
        text user_agent "nullable"
        text payload "required"
        integer last_activity "required"
    }
    cache {
        varchar key PK "required"
        text value "required"
        integer expiration "required"
    }
    cache_locks {
        varchar key PK "required"
        varchar owner "required"
        integer expiration "required"
    }
    jobs {
        bigint id PK "required"
        varchar queue "required"
        text payload "required"
        smallint attempts "required"
        integer reserved_at "nullable"
        integer available_at "required"
        integer created_at "required"
    }
    job_batches {
        varchar id PK "required"
        varchar name "required"
        integer total_jobs "required"
        integer pending_jobs "required"
        integer failed_jobs "required"
        text failed_job_ids "required"
        text options "nullable"
        integer cancelled_at "nullable"
        integer created_at "required"
        integer finished_at "nullable"
    }
    failed_jobs {
        bigint id PK "required"
        varchar uuid UK "required"
        text connection "required"
        text queue "required"
        text payload "required"
        text exception "required"
        timestamp failed_at "required"
    }
    migrations {
        integer id PK "required"
        varchar migration "required"
        integer batch "required"
    }
